<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by dwb from packaging/msi/widget.wxs.tmpl. Per-user install, no admin rights needed. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="{{.Name}}" Manufacturer="{{.Vendor}}" Version="{{.Version}}"
           UpgradeCode="{{.UpgradeCode}}" Scope="perUser" Compressed="yes" Language="1033">
    <SummaryInformation Description="{{.Description}}" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="{{.Ico}}" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="{{.Homepage}}" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="VendorDir" Name="DesktopWidgets">
          <Directory Id="INSTALLFOLDER" Name="{{.Binary}}" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="MenuDir" Name="DesktopWidgets" />
    </StandardDirectory>

    <ComponentGroup Id="Main">
      <Component Id="Exe" Directory="INSTALLFOLDER" Guid="{{.ExeGuid}}">
        <File Id="ExeFile" Source="{{.Exe}}" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\DesktopWidgets\{{.Binary}}" Name="Version" Type="string" Value="{{.Version}}" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallDir" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveVendorDir" Directory="VendorDir" On="uninstall" />
      </Component>
      <Component Id="Shortcut" Directory="MenuDir" Guid="{{.ShortcutGuid}}">
        <Shortcut Id="StartMenuShortcut" Name="{{.Name}}" Description="{{.Description}}"
                  Target="[INSTALLFOLDER]{{.Binary}}.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\DesktopWidgets\{{.Binary}}" Name="Shortcut" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveMenuDir" Directory="MenuDir" On="uninstall" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main">
      <ComponentGroupRef Id="Main" />
    </Feature>
  </Package>
</Wix>
